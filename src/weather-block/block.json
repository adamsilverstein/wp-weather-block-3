{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "weather-block/weather-block",
	"version": "0.1.0",
	"title": "Weather Block",
	"category": "widgets",
	"icon": "cloud",
	"description": "Display current weather information for a specified location.",
	"example": {},
	"attributes": {
		"location": {
			"type": "string",
			"default": ""
		},
		"units": {
			"type": "string",
			"default": "metric"
		},
		"displayMode": {
			"type": "string",
			"default": "auto"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"textdomain": "weather-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
