<?xml version="1.0"?>
<ruleset name="Weather Block Coding Standards">
	<description>Coding standards for Weather Block plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude patterns -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Show progress -->
	<arg value="sp"/>

	<!-- Strip the file paths down to the relevant bit -->
	<arg name="basepath" value="./"/>

	<!-- Check up to 8 files simultaneously -->
	<arg name="parallel" value="8"/>

	<!-- Enable colors -->
	<arg name="colors"/>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow array short syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		
		<!-- Allow short echo tags in templates -->
		<exclude name="Generic.PHP.DisallowShortOpenTag.EchoFound"/>
	</rule>

	<!-- Use WordPress-Extra rules -->
	<rule ref="WordPress-Extra"/>

	<!-- Use WordPress-Docs rules -->
	<rule ref="WordPress-Docs"/>

	<!-- Minimum PHP version -->
	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="7.4-"/>
	
	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="weather-block"/>
		</properties>
	</rule>

	<!-- Prefix check -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="weather_block,Weather_Block"/>
		</properties>
	</rule>
</ruleset>